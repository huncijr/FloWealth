# Domain without protocol
APP_DOMAIN=flowealth.eu

# Existing Docker network used by Nginx Proxy Manager
PROXY_NETWORK=nginx-proxy-manager_default

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication and bot protection
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
CLOUDFLARE_SECRET_KEY=replace-with-turnstile-secret-key
VITE_CLOUDFLARE_SITE_KEY=replace-with-turnstile-site-key

# Email
RESEND_API=replace-with-resend-api-key
EMAIL_FROM=FloWealth <no-reply@example.com>

# AI service
AI_API_KEY=replace-with-ai-api-key
API_URL=https://example-ai-api.invalid/v1
AI_MODEL=replace-with-model-name

# Market data
FINNHUB_API_KEY=replace-with-finnhub-api-key
